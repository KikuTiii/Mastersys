@baseUrl = http://localhost:8080

### Cadastrar Aluno
POST {{baseUrl}}/alunos
Content-Type: application/json

{
  "nome": "Matheus kikuti",
  "dataNascimento": "2004-05-16",
  "sexo": "M",
  "telefone": "123456789",
  "celular": "123456789",
  "email": "matheus@gmail.com",
  "observacao": "Aluno iniciante",
  "endereco": "Avenida jabaquara",
  "complemento": "apartamento 702",
  "bairro": "mirandopolis",
  "cidade": "sao paulo",
  "estado": "sp",
  "cep": null
}


### Listar Alunos
GET {{baseUrl}}/alunos


### Listar Alunos com paginação
GET {{baseUrl}}/alunos?page=0&size=10&sort=nome,asc

### Buscar aluno por ID
GET {{baseUrl}}/alunos/1

###Atualizar ALuno
PUT {{baseUrl}}/alunos/1
Content-Type: application/json

{
  "nome": "Matheus kikuti atualizado",
  "dataNascimento": "2004-05-16",
  "sexo": "M",
  "telefone": "123456789",
  "celular": "123456789",
  "email": "matheus@gmail.com",
  "observacao": "Aluno iniciante",
  "endereco": "Avenida jabaquara",
  "complemento": "apartamento 702",
  "bairro": "mirandopolis",
  "cidade": "sao paulo",
  "estado": "sp",
  "cep": null
}

### Excluir Aluno
DELETE {{baseUrl}}/alunos/1


### Listar Todos
GET {{baseUrl}}/alunos?page=0&size=10&sort=nome,asc

### Listar por nome
GET {{baseUrl}}/alunos?nome=joao&page=0&size=10&sort=nome,asc

### Listar por cidade
GET {{baseUrl}}/alunos?cidade=sao paulo&page=0&size=10&sort=nome,asc

### Listar por estado
GET {{baseUrl}}/alunos?estado=sp&page=0&size=10&sort=nome,asc

### Listar por email
GET {{baseUrl}}/alunos?email=matheus@gmail.com&page=0&size=10&sort=nome,asc



### Faturamento mensal
GET {{baseUrl}}/relatorios/faturamento-mensal

### Alunos por cidade
GET {{baseUrl}}/relatorios/alunos-por-cidade

### Faturas em aberto
GET {{baseUrl}}/relatorios/faturas-em-aberto